@model IEnumerable<RouteXWms.Models.DistanceFreight>
@{
    ViewData["Title"] = "輸送運賃マスター";
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 1;
    bool showDeleted = ViewBag.ShowDeleted ?? false;
    var freightTables = ViewBag.FreightTables as IEnumerable<RouteXWms.Models.FreightTable> ?? Enumerable.Empty<RouteXWms.Models.FreightTable>();
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="wms-card">
    <div class="wms-card-header">
        <h2 class="wms-card-title"><i class="bi bi-currency-yen me-2 text-success"></i>輸送運賃マスター一覧</h2>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-wms-primary" data-bs-toggle="modal" data-bs-target="#editModal" onclick="openCreateModal()">
                <i class="bi bi-plus-lg me-1"></i> 新規作成
            </button>
            <button type="button" class="btn btn-wms-secondary" data-bs-toggle="modal" data-bs-target="#importModal">
                <i class="bi bi-upload me-1"></i> CSVインポート
            </button>
            <a asp-action="ExportCsv" class="btn btn-wms-secondary">
                <i class="bi bi-download me-1"></i> CSVエクスポート
            </a>
            <button type="button" id="btnBatchDelete" class="btn btn-outline-danger" disabled onclick="submitBatchDelete()">
                <i class="bi bi-trash me-1"></i> まとめて削除
            </button>
        </div>
    </div>

    <!-- Search & Filters -->
    <form method="get" asp-action="Index" class="row g-3 mb-4">
        <div class="col-md-4">
            <select name="freightTableId" class="form-select bg-dark text-white border-secondary" onchange="this.form.submit()">
                <option value="">-- 全ての料金表 --</option>
                @foreach (var dt in freightTables)
                {
                    <!option value="@dt.FreightTableId" @(ViewBag.SelectedRateId == dt.FreightTableId ? "selected" : "")>@dt.RateName</!option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="pageSize" class="form-select bg-dark text-white border-secondary" onchange="this.form.submit()">
                <!option value="10" @(pageSize == 10 ? "selected" : "")>10件 / ページ</!option>
                <!option value="20" @(pageSize == 20 ? "selected" : "")>20件 / ページ</!option>
                <!option value="50" @(pageSize == 50 ? "selected" : "")>50件 / ページ</!option>
                <!option value="100" @(pageSize == 100 ? "selected" : "")>100件 / ページ</!option>
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-center">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="showDeleted" value="true" id="showDeletedCheck" @(showDeleted ? "checked" : "") onchange="this.form.submit()" />
                <label class="form-check-label text-secondary ms-2" for="showDeletedCheck">削除済み</label>
            </div>
        </div>
        <div class="col-md-3 text-end">
            <button type="submit" class="btn btn-wms-secondary w-100">絞り込み</button>
        </div>
    </form>

    <!-- Table -->
    <form id="batchDeleteForm" method="post" asp-action="BatchDelete">
        @Html.AntiForgeryToken()
        <div class="table-responsive">
            <table class="table table-wms">
                <thead>
                    <tr>
                        <th style="width: 40px;"><input type="checkbox" class="form-check-input" id="checkAll" onclick="toggleSelectAll(this)" /></th>
                        <th>料金表名</th>
                        <th>距離 (km)</th>
                        <th>サイズ (kg)</th>
                        <th>原価 (円)</th>
                        <th>売価 (円)</th>
                        <th>ステータス</th>
                        <th class="text-end">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-secondary py-4">データが存在しません。</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr class="@(item.IsDeleted ? "opacity-50" : "")">
                                <td>
                                    @if (!item.IsDeleted)
                                    {
                                        <input type="checkbox" name="ids" value="@item.FreightId" class="form-check-input row-checkbox" onclick="updateBatchButton()" />
                                    }
                                </td>
                                <td>@(item.FreightTable?.RateName ?? "-")</td>
                                <td>@item.DistanceKm.ToString("N0") km</td>
                                <td><span class="badge bg-secondary">@item.Size kg</span></td>
                                <td>¥@item.Cost.ToString("N0")</td>
                                <td class="fw-bold text-success">¥@item.Price.ToString("N0")</td>
                                <td>
                                    @if (item.IsDeleted)
                                    {
                                        <span class="badge bg-danger">削除済</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">有効</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-info me-1" onclick="openEditModal('@item.FreightId', '@item.FreightTableId', '@item.DistanceKm', '@item.Size', '@item.Cost', '@item.Price')">
                                        <i class="bi bi-pencil"></i> 編集
                                    </button>
                                    @if (item.IsDeleted)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success" onclick="restoreItem('@item.FreightId')">
                                            <i class="bi bi-arrow-counterclockwise"></i> 復活
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteItem('@item.FreightId')">
                                            <i class="bi bi-trash"></i> 削除
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </form>

    <!-- Pagination -->
    <partial name="_Pagination" />
</div>

<!-- Save Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white border-secondary">
            <form method="post" asp-action="Save">
                @Html.AntiForgeryToken()
                <div class="modal-header border-secondary">
                    <h5 class="modal-title" id="modalTitle">輸送運賃情報</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="FreightId" name="FreightId" />
                    <div class="mb-3">
                        <label class="form-label">料金表 <span class="text-danger">*</span></label>
                        <select id="FreightTableId" name="FreightTableId" class="form-select bg-secondary text-white border-0" required>
                            <option value="">-- 選択してください --</option>
                            @foreach (var dt in freightTables)
                            {
                                <option value="@dt.FreightTableId">@dt.RateName</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label">基準距離 (km) <span class="text-danger">*</span></label>
                            <input type="number" id="DistanceKm" name="DistanceKm" class="form-control bg-secondary text-white border-0" required min="0" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">サイズ (kg) <span class="text-danger">*</span></label>
                            <input type="number" id="Size" name="Size" class="form-control bg-secondary text-white border-0" required min="0" placeholder="重量を整数で入力..." />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label">原価 (円) <span class="text-danger">*</span></label>
                            <input type="number" step="1" id="Cost" name="Cost" class="form-control bg-secondary text-white border-0" required min="0" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">買価 (円) <span class="text-danger">*</span></label>
                            <input type="number" step="1" id="Price" name="Price" class="form-control bg-secondary text-white border-0" required min="0" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
                    <button type="submit" class="btn btn-wms-primary">保存</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Import Modal -->
<div class="modal fade" id="importModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white border-secondary">
            <form id="importForm" onsubmit="submitImportStream(event, '@Url.Action("ImportCsvStream")')">
                @Html.AntiForgeryToken()
                <div class="modal-header border-secondary">
                    <h5 class="modal-title"><i class="bi bi-file-earmark-spreadsheet me-2"></i>輸送運賃マスター CSVインポート</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="importFormArea">
                        <div class="mb-3">
                            <label class="form-label text-light fw-semibold">CSVファイルを選択</label>
                            <input type="file" name="csvFile" accept=".csv" class="form-control bg-secondary text-white border-0" required />
                            <p class="small text-secondary mt-1 mb-0">※ CSV内に親キー（運賃表ID等）が含まれていない場合、自動検出して適用する料金表の選択画面が表示されます。</p>
                        </div>
                        <div class="mb-3 form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="createIfNotFound" value="true" id="createIfNotFound_df" checked />
                            <label class="form-check-label text-white" for="createIfNotFound_df">未存在設定のレコードを新規作成する（OFF時はエラー）</label>
                        </div>
                    </div>

                    <!-- 動的マスター補完選択エリア (CSV内に空キーが検出された場合のみ表示) -->
                    <div id="importSelectionArea" class="d-none border border-warning rounded p-3 mb-3 bg-dark">
                        <div class="text-warning fw-bold mb-2"><i class="bi bi-exclamation-triangle-fill me-2"></i>適用マスターの選択が必要です</div>
                        <p class="small text-light mb-3">取り込まれたCSV内に未指定（空）のキーが検出されました。適用するマスターを選択してください。</p>
                        <div id="selectionFields"></div>
                        <button type="submit" class="btn btn-warning w-100 fw-bold mt-2"><i class="bi bi-play-fill me-1"></i>選択したマスターで処理を続行</button>
                    </div>

                    <!-- Realtime Progress Bar Area -->
                    <div id="importProgressArea" class="d-none text-center py-2">
                        <div class="mb-2 fw-semibold text-info" id="importStatusTitle">輸送運賃データ処理中...</div>
                        <div class="progress mb-3 bg-secondary" style="height: 22px;">
                            <div id="importProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%;"></div>
                        </div>
                        <div id="importCountText" class="fw-bold fs-5 text-white mb-1">0 / 0 件 (0%)</div>
                        <div id="importCurrentKeyText" class="badge bg-dark border border-secondary text-light px-3 py-2 fs-6">処理中の対象データ: -</div>
                        <div id="importAlert" class="alert d-none mt-3 mb-0" role="alert"></div>
                    </div>
                </div>
                <div id="importFooter" class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
                    <button type="submit" class="btn btn-wms-primary">インポート実行</button>
                </div>
                <div id="importCloseBtn" class="modal-footer border-secondary d-none">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="location.reload()">閉じる</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Forms for Delete & Restore -->
<form id="singleDeleteForm" method="post" asp-action="Delete">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteId" />
</form>
<form id="singleRestoreForm" method="post" asp-action="Restore">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="restoreId" />
</form>

@section Scripts {
    <script>
        function openCreateModal() {
            document.getElementById('modalTitle').innerText = '輸送運賃新規作成';
            document.getElementById('FreightId').value = '';
            document.getElementById('FreightTableId').value = '';
            document.getElementById('DistanceKm').value = '0';
            document.getElementById('Size').value = '0';
            document.getElementById('Cost').value = '0';
            document.getElementById('Price').value = '0';
        }

        function openEditModal(id, rateId, dist, size, cost, price) {
            document.getElementById('modalTitle').innerText = '輸送運賃編集';
            document.getElementById('FreightId').value = id;
            document.getElementById('FreightTableId').value = rateId;
            document.getElementById('DistanceKm').value = dist;
            document.getElementById('Size').value = size;
            document.getElementById('Cost').value = cost;
            document.getElementById('Price').value = price;
            var modal = new bootstrap.Modal(document.getElementById('editModal'));
            modal.show();
        }

        function deleteItem(id) {
            if (confirm('この運賃を削除しますか？')) {
                document.getElementById('deleteId').value = id;
                document.getElementById('singleDeleteForm').submit();
            }
        }

        function restoreItem(id) {
            if (confirm('この運賃を復活させますか？')) {
                document.getElementById('restoreId').value = id;
                document.getElementById('singleRestoreForm').submit();
            }
        }

        function toggleSelectAll(master) {
            var checkboxes = document.querySelectorAll('.row-checkbox');
            checkboxes.forEach(c => c.checked = master.checked);
            updateBatchButton();
        }

        function updateBatchButton() {
            var selected = document.querySelectorAll('.row-checkbox:checked').length;
            document.getElementById('btnBatchDelete').disabled = (selected === 0);
        }

        function submitBatchDelete() {
            if (confirm('選択した設定をまとめて削除しますか？')) {
                document.getElementById('batchDeleteForm').submit();
            }
        }

        window.masterOptions = {
            freightTables: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                ((IEnumerable<RouteXWms.Models.FreightTable>)ViewBag.FreightTables ?? Enumerable.Empty<RouteXWms.Models.FreightTable>())
                .Select(ft => new { id = ft.FreightTableId, name = ft.RateName })
            ))
        };
    </script>
}
