@model IEnumerable<RouteXWms.Models.Outbound>

@{
    ViewData["Title"] = "出荷指示明細";
    var instruction = ViewBag.ShippingInstruction as RouteXWms.Models.ShippingInstruction;
    var pageIndex = ViewBag.Page as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 10;
    var search = ViewBag.Search as string;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
}

<div class="container-fluid px-0">
    <!-- Header Navigation & Title -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <a asp-action="ShippingInstructionList" class="btn btn-outline-secondary btn-sm px-3">
                <i class="bi bi-arrow-left me-1"></i> 指示一覧に戻る
            </a>
            <h2 class="h4 text-white mb-0">
                <i class="bi bi-file-earmark-spreadsheet me-2 text-info"></i>出荷指示明細確認
            </h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ConfirmWarehouse" asp-route-groupCode="@(instruction?.ShippingInstructionGroup)" class="btn btn-warning text-dark btn-sm fw-bold px-3">
                <i class="bi bi-shield-check me-1"></i> このグループの出荷倉庫確認へ
            </a>
        </div>
    </div>

    <!-- Instructions Summary Card -->
    <div class="wms-card mb-4" style="background-color: #0f172a;">
        <div class="card-body p-4 text-white">
            <div class="row g-4">
                <div class="col-md-4 col-lg-3">
                    <div class="text-secondary small">出荷指示グループ</div>
                    <div class="fs-5 font-monospace font-weight-bold text-info">
                        @(instruction?.ShippingInstructionGroup ?? "-")
                    </div>
                </div>
                <div class="col-md-4 col-lg-3">
                    <div class="text-secondary small">元Excelファイル名</div>
                    <div class="fs-6 text-truncate" title="@instruction?.FileName">
                        <i class="bi bi-file-earmark-excel text-success me-1"></i>
                        @(string.IsNullOrEmpty(instruction?.FileName) ? "-" : instruction.FileName)
                    </div>
                </div>
                <div class="col-md-4 col-lg-3">
                    <div class="text-secondary small">荷主 / 運送会社</div>
                    <div class="fs-6 fw-semibold">
                        @(instruction?.Shipper?.ShipperName ?? "-") / @(instruction?.Carrier?.CarrierName ?? "-")
                    </div>
                </div>
                <div class="col-md-4 col-lg-3">
                    <div class="text-secondary small">読込日時 / 重量指定</div>
                    <div class="fs-6">
                        <span class="text-secondary">@(instruction?.CreatedAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")</span>
                        <span class="badge bg-secondary ms-1">@(instruction?.WeightSpec == "fixed30" ? "30Kg固定" : "商品マスタ参照")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Form & Table Card -->
    <div class="wms-card mb-4">
        <div class="wms-card-header d-flex justify-content-between align-items-center flex-wrap gap-3">
            <h5 class="wms-card-title mb-0">
                取り込み明細データ (@totalCount 件)
            </h5>
            <!-- 明細内検索 -->
            <form method="get" asp-action="ShippingInstructionDetail" class="m-0">
                <input type="hidden" name="id" value="@(instruction?.ShippingInstructionId)" />
                <div class="input-group input-group-sm" style="width: 320px;">
                    <span class="input-group-text bg-dark text-secondary border-secondary">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" value="@search" class="form-control bg-dark text-white border-secondary" placeholder="納品先・氏名・商品コード等..." />
                    <button type="submit" class="btn btn-secondary btn-sm px-3">検索</button>
                    @if (!string.IsNullOrEmpty(search))
                    {
                        <a asp-action="ShippingInstructionDetail" asp-route-id="@(instruction?.ShippingInstructionId)" class="btn btn-outline-secondary btn-sm">クリア</a>
                    }
                </div>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle border-secondary mb-0" style="font-size: 0.9rem;">
                <thead>
                    <tr class="table-dark text-secondary" style="border-bottom: 2px solid #334155;">
                        <th style="width: 110px;">納品先コード</th>
                        <th style="width: 220px;">お届け先名称 / 住所 / TEL</th>
                        <th style="width: 160px;">商品コード / 品名</th>
                        <th style="width: 110px;" class="text-center">数量(箱/部)</th>
                        <th style="width: 90px;" class="text-center">総重量</th>
                        <th style="width: 110px;">日付 (出荷/配達)</th>
                        <th style="width: 160px;">備考・特記事項</th>
                        <th style="width: 110px;" class="text-center">ステータス</th>
                        <th style="width: 70px;" class="text-center">詳細</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                条件に一致する明細データはありません。
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="font-monospace text-info">@(item.RecipientCode ?? "-")</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-white">
                                        @item.CompanyName1 @item.CompanyName2 @item.RecipientName
                                    </div>
                                    <div class="small text-secondary text-truncate" style="max-width: 220px;" title="〒@item.ZipCode @item.Address1 @item.Address2 @item.Address3">
                                        〒@item.ZipCode @item.Address1 @item.Address2 @item.Address3
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.Tel))
                                    {
                                        <div class="small text-muted font-monospace"><i class="bi bi-telephone me-1"></i>@item.Tel</div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-warning font-monospace">@item.ProductId</div>
                                    <div class="small text-secondary text-truncate" style="max-width: 160px;" title="@item.Product?.ProductName">
                                        @(item.Product?.ProductName ?? "-")
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="fw-bold text-success">@item.CaseCount 箱</span>
                                    <div class="small text-secondary">(@item.TotalPieces 部)</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary font-monospace">
                                        @(item.OutboundWeight.HasValue ? $"{item.OutboundWeight.Value} kg" : "-")
                                    </span>
                                </td>
                                <td>
                                    <div class="small text-nowrap">出荷: @(item.ScheduledOutboundDate?.ToString("yyyy/MM/dd") ?? "-")</div>
                                    <div class="small text-muted text-nowrap">配達: @(item.ScheduledDeliveryDate?.ToString("yyyy/MM/dd") ?? "-")</div>
                                </td>
                                <td>
                                    <div class="small text-truncate" style="max-width: 160px;" title="@item.Notes @item.Memo">
                                        @(string.IsNullOrEmpty(item.Notes) ? (string.IsNullOrEmpty(item.Memo) ? "-" : item.Memo) : item.Notes)
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.TransportCode))
                                    {
                                        <div class="small text-info">輸送: @item.TransportCode</div>
                                    }
                                </td>
                                <td class="text-center">
                                    @switch (item.Status)
                                    {
                                        case 1:
                                            <span class="badge bg-warning text-dark">確認中</span>
                                            break;
                                        case 11:
                                            <span class="badge bg-success">予定 (確定)</span>
                                            break;
                                        case 21:
                                            <span class="badge bg-primary">送状出力済</span>
                                            break;
                                        case 31:
                                            <span class="badge bg-info text-dark">請求済</span>
                                            break;
                                        case 801:
                                            <span class="badge bg-danger">該当料金無</span>
                                            break;
                                        case 998:
                                            <span class="badge bg-danger">在庫切れ</span>
                                            break;
                                        case 999:
                                            <span class="badge bg-secondary">取消済</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-outline-info btn-sm px-2 py-0" data-bs-toggle="modal" data-bs-target="#detailModal-@item.OutboundId">
                                        <i class="bi bi-info-circle"></i>
                                    </button>

                                    <!-- 明細全22列確認用 モーダルダイアログ -->
                                    <div class="modal fade text-start" id="detailModal-@item.OutboundId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-lg modal-dialog-centered">
                                            <div class="modal-content bg-dark text-white border-secondary">
                                                <div class="modal-header border-secondary">
                                                    <h5 class="modal-title text-info">
                                                        <i class="bi bi-card-text me-2"></i>出荷指示明細レコード詳細 (全22列項目)
                                                    </h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body p-4">
                                                    <div class="row g-3">
                                                        <div class="col-md-6">
                                                            <div class="p-3 rounded border border-secondary" style="background-color: #0f172a;">
                                                                <h6 class="text-primary border-bottom border-secondary pb-2 mb-3"><i class="bi bi-geo-alt me-1"></i>お届け先・宛先情報</h6>
                                                                <div class="mb-2"><span class="text-secondary">納品先コード:</span> <span class="text-info font-monospace ms-1">@(item.RecipientCode ?? "-")</span></div>
                                                                <div class="mb-2"><span class="text-secondary">郵便番号:</span> <span class="text-white ms-1">〒@(item.ZipCode ?? "-")</span></div>
                                                                <div class="mb-2"><span class="text-secondary">住所:</span> <span class="text-white ms-1">@item.Address1 @item.Address2 @item.Address3</span></div>
                                                                <div class="mb-2"><span class="text-secondary">会社名/宛先名:</span> <span class="text-white fw-bold ms-1">@item.CompanyName1 @item.CompanyName2 @item.RecipientName</span></div>
                                                                <div><span class="text-secondary">電話番号:</span> <span class="text-white font-monospace ms-1">@(item.Tel ?? "-")</span></div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <div class="p-3 rounded border border-secondary" style="background-color: #0f172a;">
                                                                <h6 class="text-warning border-bottom border-secondary pb-2 mb-3"><i class="bi bi-box-seam me-1"></i>商品・数量・重量情報</h6>
                                                                <div class="mb-2"><span class="text-secondary">商品コード:</span> <span class="text-warning font-monospace fw-bold ms-1">@item.ProductId</span></div>
                                                                <div class="mb-2"><span class="text-secondary">品名:</span> <span class="text-white ms-1">@(item.Product?.ProductName ?? "-")</span></div>
                                                                <div class="mb-2"><span class="text-secondary">ケース入数 (PackQty):</span> <span class="text-white ms-1">@(item.PackQty.HasValue ? $"{item.PackQty.Value} 個/箱" : "-")</span></div>
                                                                <div class="mb-2"><span class="text-secondary">品名部数 / 出荷ケース数:</span> <span class="text-success fw-bold ms-1">@item.TotalPieces 部 / @item.CaseCount 箱</span></div>
                                                                <div><span class="text-secondary">総重量:</span> <span class="text-white ms-1">@(item.OutboundWeight.HasValue ? $"{item.OutboundWeight.Value} kg" : "-")</span></div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <div class="p-3 rounded border border-secondary" style="background-color: #0f172a;">
                                                                <h6 class="text-info border-bottom border-secondary pb-2 mb-3"><i class="bi bi-calendar-event me-1"></i>日付・配送区分</h6>
                                                                <div class="mb-2"><span class="text-secondary">出荷予定日:</span> <span class="text-white ms-1">@(item.ScheduledOutboundDate?.ToString("yyyy/MM/dd") ?? "-")</span></div>
                                                                <div class="mb-2"><span class="text-secondary">配達予定日:</span> <span class="text-white ms-1">@(item.ScheduledDeliveryDate?.ToString("yyyy/MM/dd") ?? "-")</span></div>
                                                                <div class="mb-2"><span class="text-secondary">配達時間帯区分:</span> <span class="text-white ms-1">@(item.DeliveryTimeClass.HasValue ? item.DeliveryTimeClass.Value.ToString() : "-")</span></div>
                                                                <div><span class="text-secondary">輸送コード:</span> <span class="text-info ms-1">@(item.TransportCode ?? "-")</span></div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <div class="p-3 rounded border border-secondary" style="background-color: #0f172a;">
                                                                <h6 class="text-success border-bottom border-secondary pb-2 mb-3"><i class="bi bi-file-text me-1"></i>納品書適用・備考・メモ</h6>
                                                                <div class="mb-2"><span class="text-secondary">記事:</span> <span class="text-white ms-1">@(item.Notes ?? "-")</span></div>
                                                                <div class="mb-2"><span class="text-secondary">納品書適用1:</span> <span class="text-white ms-1">@(item.DeliveryNoteApp1 ?? "-")</span></div>
                                                                <div class="mb-2"><span class="text-secondary">納品書適用2:</span> <span class="text-white ms-1">@(item.DeliveryNoteApp2 ?? "-")</span></div>
                                                                <div class="mb-2"><span class="text-secondary">納品書備考:</span> <span class="text-white ms-1">@(item.DeliveryNoteNotes ?? "-")</span></div>
                                                                <div><span class="text-secondary">メモ（フリーワード）:</span> <span class="text-white ms-1">@(item.Memo ?? "-")</span></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-secondary">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">閉じる</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- ページネーション -->
        @if (totalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center p-3 border-top border-secondary">
                <div class="text-muted small">
                    全 @totalPages ページ中 @pageIndex ページ目を表示
                </div>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm m-0">
                        <li class="page-item @(pageIndex <= 1 ? "disabled" : "")">
                            <a class="page-link bg-dark text-white border-secondary" asp-action="ShippingInstructionDetail" asp-route-id="@(instruction?.ShippingInstructionId)" asp-route-search="@search" asp-route-page="@(pageIndex - 1)">前へ</a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == pageIndex ? "active" : "")">
                                <a class="page-link @(p == pageIndex ? "bg-primary border-primary text-white" : "bg-dark text-white border-secondary")" asp-action="ShippingInstructionDetail" asp-route-id="@(instruction?.ShippingInstructionId)" asp-route-search="@search" asp-route-page="@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(pageIndex >= totalPages ? "disabled" : "")">
                            <a class="page-link bg-dark text-white border-secondary" asp-action="ShippingInstructionDetail" asp-route-id="@(instruction?.ShippingInstructionId)" asp-route-search="@search" asp-route-page="@(pageIndex + 1)">次へ</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
