@model RouteXWms.Controllers.CompareRatesViewModel

@{
    ViewData["Title"] = "出荷倉庫料金比較";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-white mb-0"><i class="bi bi-shuffle me-2 text-warning"></i>出荷倉庫 料金比較</h1>
        <a asp-action="ConfirmWarehouse" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> 倉庫確認画面に戻る
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show bg-danger text-white border-0 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Outbound Information Header -->
    <div class="wms-card mb-4">
        <div class="wms-card-header">
            <h5 class="wms-card-title text-secondary small text-uppercase mb-0"><i class="bi bi-info-circle me-1"></i>対象出庫指示データ</h5>
        </div>
        <div class="card-body p-4 bg-dark text-white">
            <div class="row g-4">
                <div class="col-md-3">
                    <div class="text-secondary small">出庫指示グループコード</div>
                    <div class="fs-5 fw-bold text-warning">@Model.Outbound.ShippingInstructionGroup</div>
                </div>
                <div class="col-md-3">
                    <div class="text-secondary small">対象商品</div>
                    <div class="fs-5 fw-semibold">@(Model.Outbound.Product?.ProductName ?? Model.Outbound.ProductId)</div>
                    <div class="small text-secondary">コード: @Model.Outbound.ProductId | 重量: @(Model.Outbound.Product?.Weight.ToString() ?? "-") kg</div>
                </div>
                <div class="col-md-2">
                    <div class="text-secondary small">出庫数量（箱数 / 部数）</div>
                    <div class="fs-5 fw-bold text-success">@Model.Outbound.CaseCount 箱 <span class="fs-6 text-white">(@Model.Outbound.TotalPieces 部)</span></div>
                </div>
                <div class="col-md-4">
                    <div class="text-secondary small">お届け先</div>
                    <div class="fs-5 fw-semibold">〒@Model.Outbound.ZipCode 【@Model.CityName】</div>
                    <div class="small text-secondary text-truncate" title="@Model.Outbound.Address1 @Model.Outbound.Address2 @Model.Outbound.Address3">
                        @Model.Outbound.Address1 @Model.Outbound.Address2 @Model.Outbound.Address3
                    </div>
                </div>
            </div>
            <hr class="border-secondary my-3" />
            <div class="row">
                <div class="col-md-3">
                    <div class="text-secondary small">宛先名 (受取人)</div>
                    <div class="fw-semibold">@Model.Outbound.CompanyName1 @Model.Outbound.RecipientName</div>
                </div>
                <div class="col-md-3">
                    <div class="text-secondary small">指定運送会社</div>
                    <div class="fw-semibold text-info">@(Model.Outbound.Carrier?.CarrierName ?? "-")</div>
                </div>
                <div class="col-md-3">
                    <div class="text-secondary small">出庫予定日</div>
                    <div>@(Model.Outbound.ScheduledOutboundDate?.ToString("yyyy-MM-dd") ?? "未指定")</div>
                </div>
                <div class="col-md-3">
                    <div class="text-secondary small">現在のステータス</div>
                    <div>
                        @switch (Model.Outbound.Status)
                        {
                            case 1: <span class="badge bg-warning text-dark">確認中</span> break;
                            case 801: <span class="badge bg-danger">該当料金無し</span> break;
                            default: <span class="badge bg-secondary">@Model.Outbound.Status</span> break;
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Candidate List Table -->
    <div class="wms-card">
        <div class="wms-card-header">
            <h5 class="wms-card-title mb-0"><i class="bi bi-list-stars me-1 text-primary"></i>候補出荷倉庫一覧（最安値順）</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-wms table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 20%;">候補倉庫名</th>
                        <th style="width: 12%;">有効在庫数</th>
                        <th style="width: 10%;">郵便番号</th>
                        <th style="width: 12%;">市区町村コード</th>
                        <th style="width: 10%;">総重量／箱数</th>
                        <th style="width: 10%;">配送距離</th>
                        <th style="width: 12%;">運賃 (円)</th>
                        <th style="width: 14%;">判定ステータス</th>
                        <th style="width: 10%;" class="text-center">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Candidates.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-secondary py-5">
                                <i class="bi bi-exclamation-circle fs-3 d-block mb-2 text-danger"></i>
                                出庫候補となる倉庫が1件も存在しません。<br />
                                運送会社と料金表のマッピング、または商品の在庫状況をご確認ください。
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var cand in Model.Candidates)
                        {
                            <tr class="@(cand.IsAdopted ? "table-active border-warning border-start border-4 text-white fw-bold" : (cand.IsSelectable ? "" : "opacity-50 bg-black-50"))">
                                <td class="fw-semibold">
                                    @cand.WarehouseName
                                </td>
                                <td>
                                    @{
                                        int reqPieces = Model.Outbound.TotalPieces > 0 ? Model.Outbound.TotalPieces : (Model.Outbound.CaseCount * (Model.Outbound.Product?.Quantity > 0 ? Model.Outbound.Product.Quantity : 1));
                                    }
                                    @if (cand.AvailablePieces >= reqPieces)
                                    {
                                        <span class="badge bg-success">@cand.AvailableCases 箱 (@cand.AvailablePieces.ToString("N0") 部)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@cand.AvailableCases 箱 (@cand.AvailablePieces.ToString("N0") 部 / 不足)</span>
                                    }
                                </td>
                                <td>
                                    <code>@cand.ZipCode</code>
                                </td>
                                <td>
                                    <code>@cand.CityCode</code>
                                </td>
                                <td>
                                    @if (cand.RateTableType == 1)
                                    {
                                        <span>@cand.Size 箱</span>
                                    }
                                    else
                                    {
                                        if (cand.FreightId.HasValue && cand.FreightTableId.HasValue)
                                        {
                                            <a href="/Outbound/FreightDetail?outboundId=@Model.Outbound.OutboundId&warehouseId=@cand.WarehouseId&freightId=@cand.FreightId" target="_blank" class="text-warning text-decoration-underline fw-bold" title="運賃計算根拠（マスタ結合）詳細で確認">
                                                @cand.Size kg <i class="bi bi-box-arrow-up-right small"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span>@cand.Size kg</span>
                                        }
                                    }
                                </td>
                                <td>
                                    @(cand.DistanceKm.HasValue ? $"{cand.DistanceKm.Value:N0} km" : "-")
                                </td>
                                <td class="fw-bold text-success">
                                    @(cand.TotalPrice.HasValue ? $"¥{cand.TotalPrice.Value:N0}" : "-")
                                </td>
                                <td>
                                    @if (cand.IsSelectable)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1"><i class="bi bi-check-circle me-1"></i>@cand.StatusMessage</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1" title="@cand.StatusMessage">
                                            <i class="bi bi-x-circle me-1"></i>
                                            @(cand.StatusMessage.Length > 20 ? cand.StatusMessage.Substring(0, 18) + "..." : cand.StatusMessage)
                                        </span>
                                    }
                                </td>
                                 <td class="text-center">
                                     @if (cand.IsSelectable)
                                     {
                                         <form method="post" asp-action="SelectWarehouse" asp-route-id="@Model.Outbound.OutboundId" asp-route-warehouseId="@cand.WarehouseId" asp-route-freightTableId="@cand.FreightTableId" onsubmit="return confirm('@cand.WarehouseName へ出荷倉庫を変更し、在庫を引き当て直します。よろしいですか？')">
                                             @Html.AntiForgeryToken()
                                             <button type="submit" class="btn btn-sm btn-warning px-3 text-nowrap fw-bold shadow-sm">
                                                 <i class="bi bi-arrow-left-right me-1"></i> 変更
                                             </button>
                                         </form>
                                     }
                                     else
                                     {
                                         <button class="btn btn-sm btn-outline-secondary px-3 text-nowrap" disabled>
                                             選択不可
                                         </button>
                                     }
                                 </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
