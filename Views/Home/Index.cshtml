@{
    ViewData["Title"] = "ダッシュボード";
}

<div class="row g-4 mb-4">
    <div class="col-md-4 col-xl-2">
        <div class="wms-card h-100 d-flex flex-column justify-content-between p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary small fw-semibold">荷主数</span>
                <i class="bi bi-building text-primary fs-4"></i>
            </div>
            <div class="fs-2 font-weight-bold text-white">@ViewBag.TotalShippers</div>
        </div>
    </div>
    <div class="col-md-4 col-xl-2">
        <div class="wms-card h-100 d-flex flex-column justify-content-between p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary small fw-semibold">倉庫数</span>
                <i class="bi bi-house-door text-info fs-4"></i>
            </div>
            <div class="fs-2 font-weight-bold text-white">@ViewBag.TotalWarehouses</div>
        </div>
    </div>
    <div class="col-md-4 col-xl-2">
        <div class="wms-card h-100 d-flex flex-column justify-content-between p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary small fw-semibold">取扱商品数</span>
                <i class="bi bi-tag text-warning fs-4"></i>
            </div>
            <div class="fs-2 font-weight-bold text-white">@ViewBag.TotalProducts</div>
        </div>
    </div>
    <div class="col-md-4 col-xl-2">
        <div class="wms-card h-100 d-flex flex-column justify-content-between p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary small fw-semibold">入庫予定数</span>
                <i class="bi bi-arrow-down-right-square text-success fs-4"></i>
            </div>
            <div class="fs-2 font-weight-bold text-white">@ViewBag.PendingInbound</div>
        </div>
    </div>
    <div class="col-md-4 col-xl-2">
        <div class="wms-card h-100 d-flex flex-column justify-content-between p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary small fw-semibold">出庫確認中数</span>
                <i class="bi bi-arrow-up-right-square text-danger fs-4"></i>
            </div>
            <div class="fs-2 font-weight-bold text-white">@ViewBag.PendingOutbound</div>
        </div>
    </div>
    <div class="col-md-4 col-xl-2">
        <div class="wms-card h-100 d-flex flex-column justify-content-between p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary small fw-semibold">総在庫ケース</span>
                <i class="bi bi-boxes text-purple fs-4" style="color: #c084fc;"></i>
            </div>
            <div class="fs-2 font-weight-bold text-white">@ViewBag.TotalInventory</div>
        </div>
    </div>
</div>

<div class="wms-card">
    <div class="wms-card-header">
        <h2 class="wms-card-title"><i class="bi bi-lightning-charge text-primary me-2"></i>クイックアクセス</h2>
    </div>
    <div class="row g-3">
        <div class="col-md-3">
            <a asp-controller="Inbound" asp-action="Register" class="btn btn-wms-primary w-100 py-3 text-start d-flex align-items-center justify-content-between">
                <div>
                    <div class="fw-bold fs-6 mb-1">新規入庫登録</div>
                    <div class="small text-white-50">入庫予定・実績データを入力</div>
                </div>
                <i class="bi bi-plus-circle fs-3"></i>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Outbound" asp-action="ImportInstruction" class="btn btn-wms-primary w-100 py-3 text-start d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                <div>
                    <div class="fw-bold fs-6 mb-1">出荷指示読込</div>
                    <div class="small text-white-50">Excelより最安値倉庫引当</div>
                </div>
                <i class="bi bi-file-earmark-excel fs-3"></i>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="Inventory" asp-action="List" class="btn btn-wms-primary w-100 py-3 text-start d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);">
                <div>
                    <div class="fw-bold fs-6 mb-1">在庫一覧確認</div>
                    <div class="small text-white-50">現在倉庫別の在庫照会</div>
                </div>
                <i class="bi bi-boxes fs-3"></i>
            </a>
        </div>
        <div class="col-md-3">
            <a asp-controller="ShipperMaster" asp-action="Index" class="btn btn-wms-primary w-100 py-3 text-start d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);">
                <div>
                    <div class="fw-bold fs-6 mb-1">マスタ管理</div>
                    <div class="small text-white-50">荷主・倉庫・各種設定</div>
                </div>
                <i class="bi bi-gear fs-3"></i>
            </a>
        </div>
    </div>
</div>
