@model IEnumerable<RouteXWms.Models.ZipCode>
@{
    ViewData["Title"] = "郵便番号マスター";
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalPages = ViewBag.TotalPages ?? 1;
    bool showDeleted = ViewBag.ShowDeleted ?? false;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="wms-card">
    <div class="wms-card-header">
        <h2 class="wms-card-title"><i class="bi bi-geo-alt me-2 text-info"></i>郵便番号マスター一覧</h2>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-wms-primary" data-bs-toggle="modal" data-bs-target="#editModal" onclick="openCreateModal()">
                <i class="bi bi-plus-lg me-1"></i> 新規作成
            </button>
            <button type="button" class="btn btn-wms-secondary" data-bs-toggle="modal" data-bs-target="#importModal">
                <i class="bi bi-upload me-1"></i> CSVインポート
            </button>
            <a asp-action="ExportCsv" class="btn btn-wms-secondary">
                <i class="bi bi-download me-1"></i> CSVエクスポート
            </a>
            <button type="button" id="btnBatchDelete" class="btn btn-outline-danger" disabled onclick="submitBatchDelete()">
                <i class="bi bi-trash me-1"></i> まとめて削除
            </button>
        </div>
    </div>

    <!-- Search & Filters -->
    <form method="get" asp-action="Index" class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-search"></i></span>
                <input type="text" name="searchZip" value="@ViewBag.SearchZip" class="form-control bg-dark text-white border-secondary" placeholder="郵便番号で検索..." />
            </div>
        </div>
        <div class="col-md-2">
            <select name="pageSize" class="form-select bg-dark text-white border-secondary" onchange="this.form.submit()">
                <!option value="10" @(pageSize == 10 ? "selected" : "")>10件 / ページ</!option>
                <!option value="20" @(pageSize == 20 ? "selected" : "")>20件 / ページ</!option>
                <!option value="50" @(pageSize == 50 ? "selected" : "")>50件 / ページ</!option>
                <!option value="100" @(pageSize == 100 ? "selected" : "")>100件 / ページ</!option>
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-center">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="showDeleted" value="true" id="showDeletedCheck" @(showDeleted ? "checked" : "") onchange="this.form.submit()" />
                <label class="form-check-label text-secondary ms-2" for="showDeletedCheck">削除済みを表示</label>
            </div>
        </div>
        <div class="col-md-3 text-end">
            <button type="submit" class="btn btn-wms-secondary px-4">絞り込み</button>
        </div>
    </form>

    <!-- Table -->
    <form id="batchDeleteForm" method="post" asp-action="BatchDelete">
        @Html.AntiForgeryToken()
        <div class="table-responsive">
            <table class="table table-wms">
                <thead>
                    <tr>
                        <th style="width: 40px;"><input type="checkbox" class="form-check-input" id="checkAll" onclick="toggleSelectAll(this)" /></th>
                        <th>郵便番号</th>
                        <th>都道府県コード</th>
                        <th>市区町村コード</th>
                        <th>ステータス</th>
                        <th class="text-end">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-secondary py-4">データが存在しません。</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr class="@(item.IsDeleted ? "opacity-50" : "")">
                                <td>
                                    @if (!item.IsDeleted)
                                    {
                                        <input type="checkbox" name="ids" value="@item.ZipCodeValue" class="form-check-input row-checkbox" onclick="updateBatchButton()" />
                                    }
                                </td>
                                <td><code>@item.ZipCodeValue</code></td>
                                <td>@item.PrefCode</td>
                                <td>@item.CityCode</td>
                                <td>
                                    @if (item.IsDeleted)
                                    {
                                        <span class="badge bg-danger">削除済</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">有効</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-info me-1" onclick="openEditModal('@item.ZipCodeValue', '@item.PrefCode', '@item.CityCode')">
                                        <i class="bi bi-pencil"></i> 編集
                                    </button>
                                    @if (item.IsDeleted)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success" onclick="restoreItem('@item.ZipCodeValue')">
                                            <i class="bi bi-arrow-counterclockwise"></i> 復活
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteItem('@item.ZipCodeValue')">
                                            <i class="bi bi-trash"></i> 削除
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </form>

    <!-- Pagination -->
    <partial name="_Pagination" />
</div>

<!-- Save Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white border-secondary">
            <form method="post" asp-action="Save">
                @Html.AntiForgeryToken()
                <input type="hidden" id="isNew" name="isNew" value="true" />
                <div class="modal-header border-secondary">
                    <h5 class="modal-title" id="modalTitle">郵便番号情報</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">郵便番号 (7桁) <span class="text-danger">*</span></label>
                        <input type="text" id="ZipCodeValue" name="ZipCodeValue" class="form-control bg-secondary text-white border-0" required maxLength="7" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">都道府県コード (2桁) <span class="text-danger">*</span></label>
                        <input type="text" id="PrefCode" name="PrefCode" class="form-control bg-secondary text-white border-0" required maxLength="2" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">市区町村コード (5桁) <span class="text-danger">*</span></label>
                        <input type="text" id="CityCode" name="CityCode" class="form-control bg-secondary text-white border-0" required maxLength="5" />
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
                    <button type="submit" class="btn btn-wms-primary">保存</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Import Modal -->
<div class="modal fade" id="importModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white border-secondary">
            <form id="importForm" onsubmit="submitImportStream(event)">
                @Html.AntiForgeryToken()
                <div class="modal-header border-secondary">
                    <h5 class="modal-title"><i class="bi bi-file-earmark-spreadsheet me-2"></i>郵便番号マスター CSVインポート</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="importFormArea">
                        <p class="small text-secondary">CSVフォーマット: 郵便番号(7桁), 都道府県コード(2桁), 市区町村コード(5桁)</p>
                        <div class="mb-3">
                            <input type="file" name="csvFile" accept=".csv" class="form-control bg-secondary text-white border-0" required />
                        </div>
                        <div class="mb-3 form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="createIfNotFound" value="true" id="createIfNotFound_zip" checked />
                            <label class="form-check-label text-white" for="createIfNotFound_zip">未存在郵便番号のレコードを新規作成する（OFF時はエラー）</label>
                        </div>
                    </div>

                    <!-- Realtime Progress Bar Area -->
                    <div id="importProgressArea" class="d-none text-center py-2">
                        <div class="mb-2 fw-semibold text-info" id="importStatusTitle">インポート処理中...</div>
                        <div class="progress mb-3 bg-secondary" style="height: 22px;">
                            <div id="importProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%;"></div>
                        </div>
                        <div id="importCountText" class="fw-bold fs-5 text-white mb-1">0 / 0 件 (0%)</div>
                        <div id="importCurrentKeyText" class="badge bg-dark border border-secondary text-light px-3 py-2 fs-6">処理中の主キー: -</div>
                        <div id="importAlert" class="alert d-none mt-3 mb-0" role="alert"></div>
                    </div>
                </div>
                <div id="importFooter" class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
                    <button type="submit" class="btn btn-wms-primary">インポート実行</button>
                </div>
                <div id="importCloseBtn" class="modal-footer border-secondary d-none">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="location.reload()">閉じる</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Forms for Delete & Restore -->
<form id="singleDeleteForm" method="post" asp-action="Delete">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteId" />
</form>
<form id="singleRestoreForm" method="post" asp-action="Restore">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="restoreId" />
</form>

@section Scripts {
    <script>
        function openCreateModal() {
            document.getElementById('modalTitle').innerText = '郵便番号新規作成';
            document.getElementById('isNew').value = 'true';
            document.getElementById('ZipCodeValue').readOnly = false;
            document.getElementById('ZipCodeValue').value = '';
            document.getElementById('PrefCode').value = '';
            document.getElementById('CityCode').value = '';
        }

        function openEditModal(zip, pref, city) {
            document.getElementById('modalTitle').innerText = '郵便番号編集';
            document.getElementById('isNew').value = 'false';
            document.getElementById('ZipCodeValue').readOnly = true;
            document.getElementById('ZipCodeValue').value = zip;
            document.getElementById('PrefCode').value = pref;
            document.getElementById('CityCode').value = city;
            var modal = new bootstrap.Modal(document.getElementById('editModal'));
            modal.show();
        }

        function deleteItem(id) {
            if (confirm('この郵便番号を削除しますか？')) {
                document.getElementById('deleteId').value = id;
                document.getElementById('singleDeleteForm').submit();
            }
        }

        function restoreItem(id) {
            if (confirm('この郵便番号を復活させますか？')) {
                document.getElementById('restoreId').value = id;
                document.getElementById('singleRestoreForm').submit();
            }
        }

        function toggleSelectAll(master) {
            var checkboxes = document.querySelectorAll('.row-checkbox');
            checkboxes.forEach(c => c.checked = master.checked);
            updateBatchButton();
        }

        function updateBatchButton() {
            var selected = document.querySelectorAll('.row-checkbox:checked').length;
            document.getElementById('btnBatchDelete').disabled = (selected === 0);
        }

        function submitBatchDelete() {
            if (confirm('選択した項目をまとめて削除しますか？')) {
                document.getElementById('batchDeleteForm').submit();
            }
        }

        async function submitImportStream(event) {
            event.preventDefault();
            var form = event.target;
            var formData = new FormData(form);

            document.getElementById('importFormArea').classList.add('d-none');
            document.getElementById('importFooter').classList.add('d-none');
            document.getElementById('importProgressArea').classList.remove('d-none');

            var pBar = document.getElementById('importProgressBar');
            var pCount = document.getElementById('importCountText');
            var pKey = document.getElementById('importCurrentKeyText');
            var pAlert = document.getElementById('importAlert');

            try {
                var response = await fetch('@Url.Action("ImportCsvStream")', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    throw new Error('サーバー通信エラー: ' + response.statusText);
                }

                var reader = response.body.getReader();
                var decoder = new TextDecoder();
                var buffer = '';

                while (true) {
                    var { done, value } = await reader.read();
                    if (done) break;

                    buffer += decoder.decode(value, { stream: true });
                    var lines = buffer.split('\n\n');
                    buffer = lines.pop();

                    for (var line of lines) {
                        line = line.trim();
                        if (line.startsWith('data: ')) {
                            var dataStr = line.substring(6);
                            try {
                                var data = JSON.parse(dataStr);
                                if (data.status === 'start' || data.status === 'processing') {
                                    var pct = data.total > 0 ? Math.floor((data.current / data.total) * 100) : 0;
                                    pBar.style.width = pct + '%';
                                    pBar.setAttribute('aria-valuenow', pct);
                                    pCount.innerText = data.current.toLocaleString() + ' / ' + data.total.toLocaleString() + ' 件 (' + pct + '%)';
                                    if (data.currentKey) {
                                        pKey.innerText = '処理中の主キー: ' + data.currentKey;
                                    }
                                } else if (data.status === 'completed') {
                                    pBar.style.width = '100%';
                                    pBar.classList.remove('progress-bar-animated', 'progress-bar-striped');
                                    pBar.classList.add('bg-success');
                                    pCount.innerText = data.total.toLocaleString() + ' / ' + data.total.toLocaleString() + ' 件 (100%)';
                                    pKey.innerText = '処理完了';
                                    pAlert.className = 'alert alert-success mt-3';
                                    pAlert.innerHTML = '<i class="bi bi-check-circle me-1"></i> ' + data.message;
                                    pAlert.classList.remove('d-none');
                                    setTimeout(function() { location.reload(); }, 1500);
                                } else if (data.status === 'error') {
                                    pBar.classList.remove('progress-bar-animated', 'progress-bar-striped');
                                    pBar.classList.add('bg-danger');
                                    pAlert.className = 'alert alert-danger mt-3';
                                    pAlert.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i> ' + data.message;
                                    pAlert.classList.remove('d-none');
                                    document.getElementById('importCloseBtn').classList.remove('d-none');
                                }
                            } catch (e) {
                                console.error('Parse error:', e);
                            }
                        }
                    }
                }
            } catch (err) {
                pAlert.className = 'alert alert-danger mt-3';
                pAlert.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i> 通信エラー: ' + err.message;
                pAlert.classList.remove('d-none');
                document.getElementById('importCloseBtn').classList.remove('d-none');
            }
        }
    </script>
}
