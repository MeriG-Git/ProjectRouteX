@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Project RouteX</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
        var accountName = HttpContextAccessor.HttpContext?.Session.GetString("AccountName") ?? "ユーザー";
    }

    <!-- Sidebar Navigation -->
    <aside class="app-sidebar">
        <div class="sidebar-header">
            <div class="sidebar-brand-icon">
                <i class="bi bi-box-seam"></i>
            </div>
            <h1 class="sidebar-brand-title">Project RouteX</h1>
        </div>

        <nav class="py-2">
            <!-- 入庫 Section -->
            <div class="nav-section-title">入庫</div>
            <ul class="sidebar-menu">
                <li>
                    <a class="nav-link @(currentController == "Inbound" && currentAction == "List" ? "active" : "")" asp-controller="Inbound" asp-action="List">
                        <i class="bi bi-arrow-down-right-square"></i> 入庫記録一覧
                    </a>
                </li>
            </ul>

            <!-- 出庫 Section -->
            <div class="nav-section-title">出庫</div>
            <ul class="sidebar-menu">
                <li>
                    <a class="nav-link @(currentController == "Outbound" && currentAction == "ShippingInstructionList" ? "active" : "")" asp-controller="Outbound" asp-action="ShippingInstructionList">
                        <i class="bi bi-file-earmark-text"></i> 出荷指示一覧
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "Outbound" && currentAction == "List" ? "active" : "")" asp-controller="Outbound" asp-action="List">
                        <i class="bi bi-arrow-up-right-square"></i> 出庫記録一覧
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "Outbound" && currentAction == "ConfirmWarehouse" ? "active" : "")" asp-controller="Outbound" asp-action="ConfirmWarehouse">
                        <i class="bi bi-shield-check"></i> 出荷倉庫確認
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "Outbound" && currentAction == "ShippingLabel" ? "active" : "")" asp-controller="Outbound" asp-action="ShippingLabel">
                        <i class="bi bi-printer"></i> 送り状出力
                    </a>
                </li>
            </ul>

            <!-- 倉庫管理 Section -->
            <div class="nav-section-title">倉庫管理</div>
            <ul class="sidebar-menu">
                <li>
                    <a class="nav-link @(currentController == "Inventory" && currentAction == "List" ? "active" : "")" asp-controller="Inventory" asp-action="List">
                        <i class="bi bi-boxes"></i> 在庫一覧
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "Inventory" && currentAction == "Summary" ? "active" : "")" asp-controller="Inventory" asp-action="Summary">
                        <i class="bi bi-calculator"></i> 在庫数
                    </a>
                </li>
            </ul>

            <!-- 帳票 Section -->
            <div class="nav-section-title">帳票</div>
            <ul class="sidebar-menu">
                <li>
                    <a class="nav-link @(currentController == "Report" ? "active" : "")" asp-controller="Report" asp-action="Index">
                        <i class="bi bi-file-earmark-bar-graph"></i> 帳票一覧
                    </a>
                </li>
            </ul>

            <!-- マスター管理 Section -->
            <div class="nav-section-title">マスター管理</div>
            <ul class="sidebar-menu">
                <li>
                    <a class="nav-link @(currentController == "ShipperMaster" ? "active" : "")" asp-controller="ShipperMaster" asp-action="Index">
                        <i class="bi bi-building"></i> 荷主
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "WarehouseMaster" ? "active" : "")" asp-controller="WarehouseMaster" asp-action="Index">
                        <i class="bi bi-house-door"></i> 倉庫
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "ProductMaster" ? "active" : "")" asp-controller="ProductMaster" asp-action="Index">
                        <i class="bi bi-tag"></i> 商品
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "ZipCodeMaster" ? "active" : "")" asp-controller="ZipCodeMaster" asp-action="Index">
                        <i class="bi bi-geo-alt"></i> 郵便番号
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "CollectionAreaMaster" ? "active" : "")" asp-controller="CollectionAreaMaster" asp-action="Index">
                        <i class="bi bi-map"></i> 集荷エリア
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "ShippingClassMaster" ? "active" : "")" asp-controller="ShippingClassMaster" asp-action="Index">
                        <i class="bi bi-diagram-2"></i> 出庫区分
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "CarrierMaster" ? "active" : "")" asp-controller="CarrierMaster" asp-action="Index">
                        <i class="bi bi-truck"></i> 運送会社
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "FreightTableMaster" ? "active" : "")" asp-controller="FreightTableMaster" asp-action="Index">
                        <i class="bi bi-table"></i> 運賃表
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "DistanceFreightMaster" ? "active" : "")" asp-controller="DistanceFreightMaster" asp-action="Index">
                        <i class="bi bi-currency-yen"></i> 輸送運賃
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "DistanceMaster" ? "active" : "")" asp-controller="DistanceMaster" asp-action="Index">
                        <i class="bi bi-geo"></i> 輸送距離
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "WarehouseDistanceRateMaster" ? "active" : "")" asp-controller="WarehouseDistanceRateMaster" asp-action="Index">
                        <i class="bi bi-link-45deg"></i> 倉庫運賃表マッピング
                    </a>
                </li>
                <li>
                    <a class="nav-link @(currentController == "IndividualFreightMaster" ? "active" : "")" asp-controller="IndividualFreightMaster" asp-action="Index">
                        <i class="bi bi-cash-coin"></i> 個配運賃
                    </a>
                </li>
            </ul>

            <!-- 各種設定 Section -->
            <div class="nav-section-title">各種設定</div>
            <ul class="sidebar-menu mb-4">
                <li>
                    <a class="nav-link @(currentController == "UserManagement" ? "active" : "")" asp-controller="UserManagement" asp-action="Index">
                        <i class="bi bi-people"></i> ユーザー
                    </a>
                </li>
            </ul>
        </nav>
    </aside>

    <!-- Main Content Wrapper -->
    <div class="main-wrapper">
        <header class="top-navbar">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5 font-weight-bold text-white">@ViewData["Title"]</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2 text-secondary">
                    <i class="bi bi-person-circle fs-5 text-primary"></i>
                    <span class="text-white font-weight-medium">@accountName</span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                        <i class="bi bi-box-arrow-right me-1"></i> ログアウト
                    </button>
                </form>
            </div>
        </header>

        <main class="content-area">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
