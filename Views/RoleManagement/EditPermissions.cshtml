@model IEnumerable<RouteXWms.Models.Permission>
@{
    ViewData["Title"] = "権限設定のカスタマイズ";
    var role = ViewBag.Role as RouteXWms.Models.Role;
    var assignedIds = ViewBag.AssignedPermissionIds as List<int> ?? new List<int>();
    var categories = Model.Select(p => p.Category).Distinct().ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 text-dark font-weight-bold mb-1">
            <i class="bi bi-shield-lock-fill text-primary me-2"></i>権限のカスタマイズ: <span class="text-primary">@role?.RoleName</span>
        </h2>
        <p class="text-muted small mb-0">ロールコード: <code>@role?.RoleCode</code> | @(role?.Description ?? "説明なし")</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>ロール一覧へ戻る
        </a>
    </div>
</div>

<form asp-action="SavePermissions" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="roleId" value="@role?.RoleId" />

    <div class="row g-4 mb-4">
        @foreach (var category in categories)
        {
            var categoryPermissions = Model.Where(p => p.Category == category).ToList();
            <div class="col-md-6">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header bg-light border-0 py-3">
                        <h5 class="card-title h6 fw-bold mb-0 text-dark">
                            <i class="bi bi-folder-fill me-2 text-warning"></i>@category
                        </h5>
                    </div>
                    <div class="card-body">
                        @foreach (var perm in categoryPermissions)
                        {
                            var isChecked = assignedIds.Contains(perm.PermissionId);
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" name="selectedPermissionIds" value="@perm.PermissionId" id="perm_@perm.PermissionId" @(isChecked ? "checked" : "") />
                                <label class="form-check-label fw-bold" for="perm_@perm.PermissionId">
                                    @perm.PermissionName
                                    <span class="badge bg-secondary bg-opacity-50 text-dark font-monospace ms-2">@perm.PermissionCode</span>
                                </label>
                                @if (!string.IsNullOrEmpty(perm.Description))
                                {
                                    <div class="form-text small text-muted">@perm.Description</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card shadow-sm border-0 sticky-bottom py-2 bg-light">
        <div class="card-body d-flex justify-content-end align-items-center">
            <a asp-action="Index" class="btn btn-secondary me-2">キャンセル</a>
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-save me-1"></i>権限設定を保存する
            </button>
        </div>
    </div>
</form>
